{
  "expo": {
    "name": "AuraLenz",
    "slug": "aura-lenz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aura-lenz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auralenz.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.auralenz.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AuraLenz to access your photos for posts and avatars.",
          "cameraPermission": "Allow AuraLenz to access your camera for taking photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AuraLenz to access your camera for taking photos and videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow AuraLenz to access your media library for posts."
        }
      ]
    ]
  }
}
